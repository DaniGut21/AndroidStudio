<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pantalla" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F3F6FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registrar vehículo" android:textSize="28sp" android:textStyle="bold" android:textColor="#17324D"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="Ingresa los datos del vehículo." android:textColor="#45566B" android:textSize="16sp"/>
        <EditText android:id="@+id/etMarca" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:hint="Marca, por ejemplo Toyota" android:inputType="textCapWords" android:maxLength="60" android:singleLine="true" android:padding="12dp" android:backgroundTint="#2563EB" android:textColor="#17324D" android:textColorHint="#526174"/>
        <EditText android:id="@+id/etModelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:hint="Modelo, por ejemplo Corolla" android:inputType="textCapWords" android:maxLength="60" android:singleLine="true" android:padding="12dp" android:backgroundTint="#2563EB" android:textColor="#17324D" android:textColorHint="#526174"/>
        <EditText android:id="@+id/etAnio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:hint="Año, por ejemplo 2024" android:inputType="number" android:maxLength="4" android:singleLine="true" android:padding="12dp" android:backgroundTint="#2563EB" android:textColor="#17324D" android:textColorHint="#526174"/>
        <EditText android:id="@+id/etPrecio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:hint="Precio COP, por ejemplo 85000000" android:inputType="numberDecimal" android:maxLength="18" android:singleLine="true" android:padding="12dp" android:backgroundTint="#2563EB" android:textColor="#17324D" android:textColorHint="#526174"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Sin separadores de miles. Máximo 2 decimales." android:textColor="#45566B" android:textSize="14sp"/>
        <Button android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:minHeight="56dp" android:text="Guardar vehículo" android:textAllCaps="false" android:textSize="16sp" android:textColor="#FFFFFF" android:backgroundTint="#2563EB"/>
        <TextView android:id="@+id/tvEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Consultando vehículos guardados…" android:textSize="16sp" android:textColor="#17324D" android:accessibilityLiveRegion="polite"/>
    </LinearLayout>
</ScrollView>